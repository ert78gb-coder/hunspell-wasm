{
  "name": "hunspell-wasm",
  "version": "1.0.0",
  "description": "Hunspell spell checker and morphological analyser compiled to WebAssembly for Node.",
  "type": "module",
  "main": "./src/index.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./src/index.js"
    }
  },
  "files": [
    "src",
    "dist",
    "types",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "sh build/build.sh",
    "test": "node --test \"test/**/*.test.js\"",
    "typecheck": "tsc --noEmit -p test/typecheck/tsconfig.json",
    "lint": "eslint ."
  },
  "keywords": [
    "hunspell",
    "spellcheck",
    "morphology",
    "wasm",
    "webassembly"
  ],
  "license": "MPL-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ert78gb-coder/hunspell-wasm.git"
  },
  "bugs": {
    "url": "https://github.com/ert78gb-coder/hunspell-wasm/issues"
  },
  "homepage": "https://github.com/ert78gb-coder/hunspell-wasm#readme",
  "devDependencies": {
    "eslint": "^10.9.1",
    "globals": "^17.12.0",
    "typescript": "^7.0.2"
  }
}
